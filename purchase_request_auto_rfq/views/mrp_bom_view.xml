<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_tree_bootstrap" model="ir.ui.view">
        <field name="name">mrp.bom.tree.bootstrap</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="is_bootstrap" invisible="1"/>
            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-muted">is_bootstrap</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_bom_search_bootstrap" model="ir.ui.view">
        <field name="name">mrp.bom.search.bootstrap</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='product']" position="after">
                <filter string="Bootstrap generated" name="bootstrap_filter"
                        domain="[('is_bootstrap', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
